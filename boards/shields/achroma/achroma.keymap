#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY layout
        default _layer {
            bindings = <
                // Left Side Upper Rows                         Right Side Upper Rows
                &kp Q      &kp W      &kp E      &kp R      &kp T         &kp Y     &kp U      &kp I      &kp O      &kp P
                &kp A      &kp S      &kp D      &kp F      &kp G         &kp H     &kp J      &kp K      &kp L      &kp SEMI
                &kp Z      &kp X      &kp C      &kp V      &kp B         &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH
                
                // Left Thumbs                                  Right Thumbs
                &kp LCTRL  &kp LSHIFT &lt LOWER SPACE                 &lt RAISE BSPC &kp ENTER &kp RALT
            >;
        };
        // numbers and symbols
        lower_layer {
            bindings = <
                &kp N1     &kp N2     &kp N3     &kp N4     &kp N5        &kp N6    &kp N7     &kp N8     &kp N9     &kp N0
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT     &kp CARET &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT   &kp BSLH
                
                // Thumbs match base layout or use &trans to let base layout pass through
                &trans     &trans     &trans                                   &trans    &kp DEL    &trans
            >;
        };

        // Layer 2: Navigation, Editing
        raise_layer {
            bindings = <
                &kp ESC    &kp HOME   &kp UP     &kp END    &kp PG_UP     &kp C_VOL_UP &kp C_PP  &kp C_NEXT &kp INS   &kp CAPS
                &kp TAB    &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN     &kp C_VOL_DN &kp LALT  &kp LCMD   &kp RCTRL &kp SQT
                &kp C_MUTE &kp C_PREV &trans     &trans     &trans        &trans       &trans    &trans     &kp GRAVE &kp TILDE
                
                // Thumbs match base layout or use &trans to let base layout pass through
                &trans     &trans     &kp SPACE                                &trans    &trans     &trans
            >;
        };
    }
}