#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,split = &split;
    };

    split: split {
        compatible = "zmk,split";
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 17 GPIO_ACTIVE_HIGH> // col0
            , <&gpio0 18 GPIO_ACTIVE_HIGH> // col1
            , <&gpio0 19 GPIO_ACTIVE_HIGH> // col2
            , <&gpio0 20 GPIO_ACTIVE_HIGH> // col3
            , <&gpio0 21 GPIO_ACTIVE_HIGH> // col4
            ;

        row-gpios
            = <&gpio0 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
            RC(0,4) RC(0,2) RC(0,0) RC(0,1) RC(0,3)
            RC(1,4) RC(1,2) RC(1,0) RC(1,1) RC(1,3)
            RC(2,4) RC(2,2) RC(2,0) RC(2,1) RC(2,3)
            RC(3,4) RC(3,2) RC(3,0)
        >;
    };
};