#include "achroma.dtsi"

/ {
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        col-offset = <5>; // Tells ZMK this side starts at column index 5

        col-gpios
            = <&pro_micro 17 GPIO_ACTIVE_HIGH> // col5
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // col6
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // col7
            , <&pro_micro 20 GPIO_ACTIVE_HIGH> // col8
            , <&pro_micro 21 GPIO_ACTIVE_HIGH> // col9
            ;

        row-gpios
            = <&pro_micro 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row0
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row1
            , <&pro_micro 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row2
            , <&pro_micro 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row3
            ;
    };
};
